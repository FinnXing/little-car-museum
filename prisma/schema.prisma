generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum DisplayType {
  REAL_3D
  GENERIC_3D
  IMAGE_SET
  STATIC_IMAGE
}

enum EnergyType {
  FUEL
  ELECTRIC
  HYBRID
  OTHER
}

enum AssetType {
  MODEL
  IMAGE
  TEXTURE
  AUDIO
  LOGO
}

enum AssetReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  ADMIN
  EDITOR
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameCn      String
  nameEn      String?
  iconUrl     String?
  description String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles VehicleCategory[]
}

model Brand {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  nameCn                String
  nameEn                String?
  aliases               String[]      @default([])
  countryRegion         String?
  logoUrl               String?
  descriptionChild      String?
  pronunciationAudioUrl String?
  isHot                 Boolean       @default(false)
  sortOrder             Int           @default(0)
  status                ContentStatus @default(DRAFT)
  assetLicenseId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  assetLicense AssetLicense? @relation("BrandAssetLicense", fields: [assetLicenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicles     Vehicle[]
}

model Vehicle {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  brandId               String?
  nameCn                String
  nameEn                String?
  childName             String?
  aliases               String[]      @default([])
  tags                  String[]      @default([])
  displayType           DisplayType
  isRealModel           Boolean       @default(false)
  energyType            EnergyType?
  seatCount             Int?
  childDescription      String
  coverImageUrl         String
  thumbnailUrl          String?
  highModelUrl          String?
  lowModelUrl           String?
  fallbackImageUrls     String[]      @default([])
  pronunciationAudioUrl String?
  defaultCamera         Json?
  isHot                 Boolean       @default(false)
  sortOrder             Int           @default(0)
  status                ContentStatus @default(DRAFT)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  brand         Brand?                @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categories    VehicleCategory[]
  colors        VehicleColor[]
  hotspots      Hotspot[]
  assetLicenses VehicleAssetLicense[]

  @@index([status, sortOrder])
  @@index([brandId, status])
}

model VehicleCategory {
  vehicleId  String
  categoryId String

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([vehicleId, categoryId])
  @@index([categoryId, vehicleId])
}

model VehicleColor {
  id              String   @id @default(cuid())
  vehicleId       String
  nameCn          String
  colorValue      String
  materialNames   String[] @default([])
  isOfficialColor Boolean  @default(false)
  sortOrder       Int      @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([vehicleId, nameCn])
  @@index([vehicleId, sortOrder])
}

model Hotspot {
  id               String  @id @default(cuid())
  vehicleId        String
  partName         String
  position         Json
  descriptionChild String?
  audioUrl         String?
  cameraPosition   Json?
  cameraTarget     Json?
  enabled          Boolean @default(true)
  sortOrder        Int     @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([vehicleId, enabled, sortOrder])
}

model AssetLicense {
  id                  String            @id @default(cuid())
  assetName           String
  assetType           AssetType
  authorName          String
  sourcePageUrl       String
  originalDownloadUrl String?
  licenseName         String
  licenseUrl          String?
  licenseFileUrl      String?
  acquiredAt          DateTime
  allowPublicDisplay  Boolean           @default(false)
  allowModification   Boolean           @default(false)
  allowCommercialUse  Boolean           @default(false)
  attributionRequired Boolean           @default(false)
  attributionText     String?
  containsTrademark   Boolean           @default(false)
  modifications       String?
  sourceScreenshotUrl String?
  reviewStatus        AssetReviewStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  brands   Brand[]               @relation("BrandAssetLicense")
  vehicles VehicleAssetLicense[]

  @@index([reviewStatus, assetType])
}

model VehicleAssetLicense {
  vehicleId      String
  assetLicenseId String

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetLicense AssetLicense @relation(fields: [assetLicenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([vehicleId, assetLicenseId])
  @@index([assetLicenseId, vehicleId])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
