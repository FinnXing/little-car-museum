# TASK-001 can run without external services. Configure these in later tasks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Replace USER and PASSWORD with the local PostgreSQL credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/little_car_museum?schema=public
AUTH_SECRET=
# Only for the one-time local admin bootstrap; set actual values in your shell.
ADMIN_EMAIL=
ADMIN_PASSWORD=

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.local/objects

MAX_HIGH_MODEL_SIZE_MB=50
MAX_LOW_MODEL_SIZE_MB=20
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=10
MAX_LICENSE_FILE_SIZE_MB=10

NEXT_PUBLIC_ANALYTICS_ENABLED=false
ERROR_MONITORING_DSN=
